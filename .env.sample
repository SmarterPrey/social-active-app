# Per-stage AWS account IDs. CDK reads these so the right account can be
# enforced/selected per stage even when CDK_DEFAULT_ACCOUNT is unset.
# Copy to `.env` and fill in real values. The .env file is gitignored.
DEV_ACCOUNT_ID=123456789012
QA_ACCOUNT_ID=123456789012
PROD_ACCOUNT_ID=123456789012

# Optional: override the region per stage (defaults to config.ts → us-east-1)
# DEV_REGION=us-east-1
# QA_REGION=us-east-1
# PROD_REGION=us-east-1
